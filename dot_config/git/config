# vim: set ft=gitconfig ts=2 sw=2:
# https://git-scm.com/docs/git-config

########################################
# Includes (Shared or Conditional)
########################################
[include]
  path = aliases.gitconfig

########################################
# User Identity
########################################
[include]
	path = user

########################################
# Core Behavior
########################################
[core]
  editor = nvim
  autocrlf = input                  # For Windows use 'true'
  excludesfile = ~/.config/git/ignore
  abbrev = 8
  precomposeUnicode = true         # Handles Unicode filenames correctly (useful on macOS)

[init]
  defaultBranch = master

########################################
# Push & Pull
########################################
[push]
  default = simple
  followTags = true
  autoSetupRemote = true

[pull]
  rebase = true

[fetch]
  all = true
  prune = true                     # Automatically delete removed remote branches
  pruneTags = true

########################################
# Rebase
########################################
[rebase]
  abbreviateCommands = true        # Use 'p' instead of 'pick'
  stat = true
  autoSquash = true
  autoStash = true

########################################
# Diff & Merge
########################################
[diff]
  mnemonicPrefix = true            # Use c/(i)ndex/(w)orking instead of a/b
  renames = true
  colorMoved = default
  algorithm = histogram

[merge]
  stat = true

[mergetool]
  keepBackup = false
  keepTemporaries = false
  writeToTemp = true
  prompt = false

########################################
# Remote Behavior
########################################

# Allows shorthand gh:some/repo to be interpreted as git@github.com:some/repo
[url "git@github.com:"]
  # useful for Homebrew when using private repos
  insteadOf = https://github.com/

########################################
# Conflict Resolution
########################################
[rerere]
  enabled = true                      # reuse recorded conflict resolutions
  autoupdate = true

########################################
# UI/UX Enhancements
########################################
[column]
  ui = auto
[color]
  ui = auto

[tag]
  sort = version:refname           # Version-aware tag sorting. 1.10.2 is AFTER 1.2.0

[commit]
  verbose = true

[status]
  branch = true                    # Show tracking branch and ahead/behind info
  showUntrackedFiles = all

[log]
  decorate = short
  abbrevCommit = true

[branch]
  sort = -committerdate            # sort branches by most recent commit date first

[blame]
  coloring = highlightRecent       # use gradient coloring to highlight recent commits
  date = relative                  # show relative dates like "2 weeks ago"

########################################
# Integrations
########################################
[include]
  path = integration.delta.gitconfig
