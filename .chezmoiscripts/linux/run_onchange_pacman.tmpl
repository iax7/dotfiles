#!/usr/bin/env zsh
{{ include ".chezmoiscripts/.common" }}

# pacman -Qqen > backup/pacman_native_list
# pacman -Qqem > backup/pacman_aur_list
task "Installing pacman packages..."

APPS=($(pkgs pacman))
sudo pacman -Syu --noconfirm
sudo pacman -S --needed --noconfirm ${APPS[@]}

AUR=($(pkgs aur))
yay -S --needed --noconfirm \
    --answerclean None --answerdiff None --answeredit None --answerupgrade None \
    ${AUR[@]}
ok
